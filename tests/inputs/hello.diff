Sample unified diff to exercise syntax highlighting and folds in vorto.
Open with `vorto assets/samples/hello.diff`.

diff --git a/greet.py b/greet.py
index 1234567..89abcde 100644
--- a/greet.py
+++ b/greet.py
@@ -1,7 +1,9 @@
-def greet(name):
-    return "Hello " + name
+def greet(name, prefix="Hello"):
+    return f"{prefix}, {name}!"


 def main():
-    print(greet("world"))
+    for name in ["Alice", "Bob"]:
+        print(greet(name))
