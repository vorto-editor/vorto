# Rust build artifacts
/target

# Pre-built grammar bundles (generated per-target by `vorto grammar bundle`,
# produced in release CI — never committed; they're large native libs)
/assets/grammars-prebuilt

# THIRD_PARTY_LICENSES is regenerated by `vorto grammar bundle` from the
# cloned grammar sources; never hand-edited, so don't track it (avoids
# stale copies). Release CI regenerates it before packaging.
/THIRD_PARTY_LICENSES

# Backup / swap files
**/*.rs.bk
*.swp
*.swo

# macOS
.DS_Store

# Editor/IDE
.idea/
.vscode/

# Local sample files for trying out new language support
/assets/samples/
